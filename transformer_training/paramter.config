Config to train using levanter framework:

#### Claude generated:

data:
  configs:
    pile:
      id: EleutherAI/pile  # Popular large-scale English dataset
  train_weights:
    pile: 1.0
  cache_dir: "gs://your-storage-bucket/tokenized/pile"
  tokenizer: "google/gemma-tokenizer"  # Better for English content

model:
  type: gemma
  seq_len: 512  # Reduced sequence length to save memory
  hidden_dim: 100000  # Increased to the target size (1 lakh)
  intermediate_dim: 200000  # Reduced multiplier from 4x to 2x to save memory
  vocab_size: 32000
  num_layers: 2  # Drastically reduced from 12 to 2
  num_heads: 50  # Increased head count to efficiently use the large hidden dimension
  num_kv_heads: 5  # Using multi-query attention to save memory
  head_dim: 2000  # Increased to work with the larger hidden dimension (100000/50)
  use_flash_attention: True
  flash_attention_block_size: 512  # Increased for better efficiency with large hidden dim

trainer:
  tracker:
   type: wandb 
   project: "wide-transformer"  # New project name

  mp: p=bf16,c=bf16  # Using bfloat16 for better memory efficiency
  train_batch_size: 32  # Significantly reduced from 256 to fit in memory
  num_train_steps: 50000  # Reduced training steps
  steps_per_eval: 250  # More frequent evaluation
  tensor_parallel_axes: ["mlp", "heads", "kv"]  # Added "kv" for more parallelism
  fsdp_axis: "embed"
  batch_axis: "batch"
  gradient_accumulation_steps: 8  # Added to compensate for smaller batch size
  checkpointer:
    base_path: "gs://your-storage-bucket/wide-transformer-100k/"
    keep:
      - every: 1000

optimizer:
  learning_rate: 1E-4  # Reduced learning rate for stability with the large model
  weight_decay: 0.01  # Slightly reduced weight decay
  min_lr_ratio: 0.1
  warmup: 0.05  # Increased warmup period for stability
  gradient_clip_norm: 1.0  # Added gradient clipping for training stability


### data:

data:
  configs:
    # Option 1: OpenWebText2 (high-quality web content)
    openwebtext2:
      id: EleutherAI/openwebtext2
      
    # Option 2: C4 (Common Crawl dataset filtered for natural language)
    c4:
      id: allenai/c4
      subset: en  # English subset
      
    # Option 3: BookCorpus + Wikipedia (classic dataset combination)
    bookcorpus_wiki:
      id: bookcorpus
    wikipedia:
      id: wikipedia
      subset: 20220301.en  # English Wikipedia
  train_weights:
    # Choose one of these options and adjust weights as needed
    openwebtext2: 1.0
    # OR
    # c4: 1.0
    # OR
    # bookcorpus: 0.5
    # wikipedia: 0.5