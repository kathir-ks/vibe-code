{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/v8-context-schema.json",
  "title": "V8 Codebase Context Schema",
  "description": "JSON schema for V8 codebase analysis context files generated by the context builder",
  "type": "object",
  "required": ["file_path"],
  "properties": {
    "file_path": {
      "type": "string",
      "description": "Absolute path to the analyzed file"
    },
    "metadata": {
      "type": "object",
      "description": "File-level metadata",
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to the file"
        },
        "file_name": {
          "type": "string",
          "description": "Name of the file including extension"
        },
        "language": {
          "type": "string",
          "enum": ["cpp", "c", "h", "hpp"],
          "description": "Programming language of the file"
        },
        "purpose": {
          "type": "string",
          "description": "Brief description of the file's purpose and functionality"
        },
        "error": {
          "type": "string",
          "description": "Error message if JSON parsing failed"
        },
        "raw_text": {
          "type": "string",
          "description": "Raw text when JSON parsing fails"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "description": "List of external dependencies referenced but not defined in this file",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["class", "func", "interface", "struct", "enum", "typedef"],
            "description": "Type of the dependency"
          },
          "metadata": {
            "$ref": "#/definitions/codeElementMetadata"
          },
          "code": {
            "type": "string",
            "description": "Minimal structural information about the dependency"
          }
        },
        "additionalProperties": false
      }
    },
    "imports": {
      "type": "object",
      "description": "Import/include statements in the file",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": ["cpp", "c", "h", "hpp"]
            },
            "purpose": {
              "type": "string",
              "description": "What functionality these imports provide"
            }
          },
          "additionalProperties": false
        },
        "code": {
          "type": "string",
          "description": "The actual import/include statements"
        }
      },
      "additionalProperties": false
    },
    "functions": {
      "type": "array",
      "description": "Functions and methods defined in the file",
      "items": {
        "type": "object",
        "properties": {
          "metadata": {
            "allOf": [
              {"$ref": "#/definitions/codeElementMetadata"},
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["function", "method", "constructor", "destructor", "operator"]
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the function"
                  },
                  "parent": {
                    "type": "string",
                    "description": "Parent class name if this is a method"
                  },
                  "about": {
                    "type": "string",
                    "description": "Brief description of what the function does"
                  },
                  "logic": {
                    "type": "string",
                    "description": "Detailed explanation of algorithm or implementation logic"
                  },
                  "parameters": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/parameter"
                    }
                  },
                  "return": {
                    "$ref": "#/definitions/returnInfo"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of function, class, or type names this function depends on"
                  }
                }
              }
            ]
          },
          "code": {
            "type": "string",
            "description": "The actual function code"
          }
        },
        "additionalProperties": false
      }
    },
    "classes": {
      "type": "array",
      "description": "Classes defined in the file",
      "items": {
        "type": "object",
        "properties": {
          "metadata": {
            "allOf": [
              {"$ref": "#/definitions/codeElementMetadata"},
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["class", "struct"]
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the class"
                  },
                  "extends": {
                    "type": "string",
                    "description": "Parent class name"
                  },
                  "implements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of interface names this class implements"
                  },
                  "about": {
                    "type": "string",
                    "description": "Brief description of the class purpose"
                  },
                  "attributes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/attribute"
                    },
                    "description": "Member variables of the class"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of class or type names this class depends on"
                  }
                }
              }
            ]
          },
          "code": {
            "type": "string",
            "description": "The actual class code"
          }
        },
        "additionalProperties": false
      }
    },
    "interfaces": {
      "type": "array",
      "description": "Interfaces (or abstract classes) defined in the file",
      "items": {
        "type": "object",
        "properties": {
          "metadata": {
            "allOf": [
              {"$ref": "#/definitions/codeElementMetadata"},
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["interface", "struct"]
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the interface"
                  },
                  "extends": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of parent interface names"
                  },
                  "about": {
                    "type": "string",
                    "description": "Brief description of the interface purpose"
                  },
                  "methods": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/method"
                    },
                    "description": "Abstract methods or method signatures"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of type names this interface depends on"
                  }
                }
              }
            ]
          },
          "code": {
            "type": "string",
            "description": "The actual interface code"
          }
        },
        "additionalProperties": false
      }
    },
    "file_level_code_content": {
      "type": "string",
      "description": "Top-level code that doesn't fit into other categories"
    },
    "error": {
      "type": "string",
      "description": "Error message if analysis failed"
    },
    "details": {
      "type": "string",
      "description": "Additional error details"
    },
    "raw_response": {
      "type": "string",
      "description": "Raw API response for debugging"
    },
    "json_error_if_any": {
      "type": "string",
      "description": "JSON parsing error details"
    },
    "xml_error": {
      "type": "string",
      "description": "XML parsing error details"
    },
    "xml_processing_error": {
      "type": "string",
      "description": "XML processing error details"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "codeElementMetadata": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": ["cpp", "c", "h", "hpp"]
        },
        "error": {
          "type": "string",
          "description": "Error message if parsing failed"
        },
        "raw_text": {
          "type": "string",
          "description": "Raw text when parsing fails"
        }
      },
      "additionalProperties": true
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "description": "Parameter type"
        },
        "purpose": {
          "type": "string",
          "description": "What this parameter is used for"
        }
      },
      "additionalProperties": false
    },
    "returnInfo": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Return type"
        },
        "description": {
          "type": "string",
          "description": "Description of what is returned"
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Attribute name"
        },
        "type": {
          "type": "string",
          "description": "Attribute type"
        },
        "access": {
          "type": "string",
          "enum": ["public", "private", "protected"],
          "description": "Access modifier"
        },
        "purpose": {
          "type": "string",
          "description": "What this attribute represents"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Method name"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          }
        },
        "return": {
          "type": "string",
          "description": "Return type"
        },
        "purpose": {
          "type": "string",
          "description": "Method purpose"
        }
      },
      "additionalProperties": false
    }
  }
}